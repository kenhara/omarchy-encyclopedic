{
  "schemaVersion": 1,
  "id": "harris.fair-witness",
  "name": "Fair Witness",
  "version": "0.1.3",
  "author": "Harris Kenny",
  "license": "MIT",
  "description": "Look it up. Report what it says. Unofficial.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "keywords": [
    "fair witness",
    "grokipedia",
    "search",
    "lookup",
    "encyclopedia",
    "heinlein",
    "witness",
    "fw",
    "look it up"
  ],
  "barWidget": {
    "displayName": "Fair Witness",
    "description": "Look it up. Report what it says. Public Grokipedia search. Unofficial.",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "resultLimit": 8
    },
    "schema": [
      {
        "key": "resultLimit",
        "type": "integer",
        "label": "Result limit",
        "description": "Max search results to request (1\u201320). Default 8.",
        "min": 1,
        "max": 20,
        "step": 1,
        "defaultValue": 8
      }
    ]
  }
}
